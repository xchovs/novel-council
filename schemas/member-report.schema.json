{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "councilId": {
      "type": "string",
      "minLength": 1
    },
    "memberId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "repaired"
      ]
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "CONFIG_INVALID",
                "ENV_KEY_MISSING",
                "PACKET_INVALID",
                "PACKET_TOO_LARGE",
                "PROVIDER_TIMEOUT",
                "PROVIDER_HTTP_ERROR",
                "PROVIDER_NETWORK_ERROR",
                "PROVIDER_BAD_JSON",
                "REPAIR_FAILED",
                "BUDGET_EXCEEDED",
                "INSUFFICIENT_COUNCIL",
                "ALL_COUNCILS_FAILED",
                "MOCK_NOT_ALLOWED",
                "OUTPUT_WRITE_FAILED",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "memberId": {
              "type": "string"
            },
            "councilId": {
              "type": "string"
            },
            "httpStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "accept",
                    "revise",
                    "reject"
                  ]
                },
                "validPremises": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "invalidPremises": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "blockingConflicts": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "externalPressures": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "offscreenEvents": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "informationFlow": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resourceAndInstitutionConstraints": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "alternativeBeats": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proposedWorldDelta": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "hypothesis",
                          "suggestion"
                        ]
                      },
                      "summary": {
                        "type": "string"
                      },
                      "rationale": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "rationale"
                    ],
                    "additionalProperties": false
                  }
                },
                "uncertainties": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "verdict",
                "validPremises",
                "invalidPremises",
                "blockingConflicts",
                "externalPressures",
                "offscreenEvents",
                "informationFlow",
                "resourceAndInstitutionConstraints",
                "alternativeBeats",
                "proposedWorldDelta",
                "uncertainties"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "accept",
                    "revise",
                    "reject"
                  ]
                },
                "characterFindings": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "canonFacts": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "inferredMotives": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "hypothesizedHistory": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "knowledgeBoundary": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "likelyPerception": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "likelyActions": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "unlikelyActions": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "emotionalProgression": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "relationshipEffects": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "conditionsForChange": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "uncertainties": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "name",
                      "canonFacts",
                      "inferredMotives",
                      "hypothesizedHistory",
                      "knowledgeBoundary",
                      "likelyPerception",
                      "likelyActions",
                      "unlikelyActions",
                      "emotionalProgression",
                      "relationshipEffects",
                      "conditionsForChange",
                      "uncertainties"
                    ],
                    "additionalProperties": false
                  }
                },
                "interactionConflicts": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "alternativeBeats": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proposedCharacterDelta": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "hypothesis",
                          "suggestion"
                        ]
                      },
                      "summary": {
                        "type": "string"
                      },
                      "rationale": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "rationale"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "verdict",
                "characterFindings",
                "interactionConflicts",
                "alternativeBeats",
                "proposedCharacterDelta"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reportId",
    "runId",
    "councilId",
    "memberId",
    "status",
    "latencyMs",
    "attempts",
    "error",
    "output"
  ],
  "additionalProperties": false
}
