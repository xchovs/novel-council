{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "characterFindings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "canonFacts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inferredMotives": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypothesizedHistory": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledgeBoundary": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likelyPerception": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likelyActions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unlikelyActions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emotionalProgression": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relationshipEffects": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditionsForChange": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "canonFacts",
          "inferredMotives",
          "hypothesizedHistory",
          "knowledgeBoundary",
          "likelyPerception",
          "likelyActions",
          "unlikelyActions",
          "emotionalProgression",
          "relationshipEffects",
          "conditionsForChange",
          "uncertainties"
        ],
        "additionalProperties": false
      }
    },
    "interactionConflicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternativeBeats": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposedCharacterDelta": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "hypothesis",
              "suggestion"
            ]
          },
          "summary": {
            "type": "string"
          },
          "rationale": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "characterFindings",
    "interactionConflicts",
    "alternativeBeats",
    "proposedCharacterDelta"
  ],
  "additionalProperties": false
}
