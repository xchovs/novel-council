{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "quick",
        "standard"
      ]
    },
    "degraded": {
      "type": "boolean"
    },
    "overallVerdict": {
      "type": "string",
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "planStrengths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worldFindings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "sourceMemberIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "topic",
          "detail",
          "severity",
          "sourceMemberIds"
        ],
        "additionalProperties": false
      }
    },
    "characterFindings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "sourceMemberIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "topic",
          "detail",
          "severity",
          "sourceMemberIds"
        ],
        "additionalProperties": false
      }
    },
    "alternativePlans": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "advantages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredChanges": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceMemberIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "summary",
          "advantages",
          "risks",
          "requiredChanges",
          "sourceMemberIds"
        ],
        "additionalProperties": false
      }
    },
    "uncertainHypotheses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposedDeltas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "hypothesis",
              "suggestion"
            ]
          },
          "summary": {
            "type": "string"
          },
          "rationale": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "questionsForMainModel": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rawRefs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "minLength": 1
          },
          "councilId": {
            "type": "string",
            "minLength": 1
          },
          "memberId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "repaired"
            ]
          }
        },
        "required": [
          "reportId",
          "councilId",
          "memberId",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "totalCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repaired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budgetExceeded": {
          "type": "boolean"
        }
      },
      "required": [
        "totalCalls",
        "succeeded",
        "failed",
        "repaired",
        "durationMs",
        "budgetExceeded"
      ],
      "additionalProperties": false
    },
    "truncation": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "droppedSections": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "applied",
        "droppedSections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "sceneId",
    "generatedAt",
    "mode",
    "degraded",
    "overallVerdict",
    "planStrengths",
    "worldFindings",
    "characterFindings",
    "alternativePlans",
    "uncertainHypotheses",
    "proposedDeltas",
    "questionsForMainModel",
    "rawRefs",
    "stats",
    "truncation"
  ],
  "additionalProperties": false
}
